# Keep in sync with .env
SQLSERVER_HOST=(local)\SQLEXPRESS
SQLSERVER_DATABASE=EverestPolyclinic
SQLSERVER_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=(local)\\SQLEXPRESS;Database=EverestPolyclinic;Trusted_Connection=Yes;TrustServerCertificate=Yes;"
DATABASE_URL="sqlserver://localhost;instanceName=SQLEXPRESS;database=EverestPolyclinic;integratedSecurity=true;trustServerCertificate=true"

# Default admin created by seed (change in production)
ADMIN_EMAIL=admin@everestpolyclinic.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Local only: open /admin without SQL Server login (never enable in production)
ADMIN_DEV_BYPASS=false
NEXT_PUBLIC_ADMIN_DEV_BYPASS=false
