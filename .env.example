# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=EverestPolyclinic
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# Prisma reads this directly. Must point at the same server as MYSQL_* above.
DATABASE_URL="mysql://your_mysql_user:your_mysql_password@127.0.0.1:3306/EverestPolyclinic"

# --- Admin panel ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@everestpolyclinic.com
ADMIN_PASSWORD=change_me
ADMIN_SESSION_SECRET=change_me_to_a_long_random_string
