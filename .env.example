# Keep in sync with .env
SQLSERVER_HOST=localhost\SQLEXPRESS
SQLSERVER_DATABASE=EverestPolyclinic
SQLSERVER_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=localhost\\SQLEXPRESS;Database=EverestPolyclinic;Trusted_Connection=Yes;TrustServerCertificate=Yes;"
DATABASE_URL="sqlserver://localhost;instanceName=SQLEXPRESS;database=EverestPolyclinic;integratedSecurity=true;trustServerCertificate=true"

# Default admin created by seed (change in production)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@everestpolyclinic.com
ADMIN_PASSWORD=Admin123
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
