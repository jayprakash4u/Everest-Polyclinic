generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SiteSetting {
  id               Int      @id @default(1)
  name             String   @db.VarChar(200)
  shortName        String   @db.VarChar(100)
  tagline          String   @db.VarChar(300)
  description      String   @db.Text
  phone            String   @db.VarChar(50)
  email            String   @db.VarChar(200)
  address          String   @db.VarChar(500)
  workingHours     String   @db.VarChar(200)
  emergencyHotline String   @db.VarChar(50)
  updatedAt        DateTime @updatedAt
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  username     String   @unique @db.VarChar(100)
  email        String   @unique @db.VarChar(200)
  passwordHash String   @db.VarChar(500)
  role         String   @default("admin") @db.VarChar(50)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DoctorCategory {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(150)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  doctors   Doctor[]
}

model Doctor {
  id         Int            @id @default(autoincrement())
  categoryId Int
  name       String         @db.VarChar(200)
  education  String         @db.VarChar(300)
  experience String         @db.VarChar(100)
  image      String         @db.VarChar(500)
  phone      String?        @db.VarChar(50)
  timing     String?        @db.VarChar(200)
  showOnHomepage Boolean    @default(false)
  sortOrder  Int            @default(0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  category   DoctorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Department {
  id          Int     @id @default(autoincrement())
  legacyId    Int?    @unique
  title       String  @db.VarChar(200)
  description String  @db.Text
  icon        String  @db.VarChar(100)
  color       String  @db.VarChar(50)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

model SpecialtyService {
  id          Int            @id @default(autoincrement())
  legacyId    Int?           @unique
  slug        String?        @unique @db.VarChar(150)
  title       String         @db.VarChar(200)
  icon        String         @db.VarChar(100)
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  detail      ServiceDetail?
}

model ServiceDetail {
  id                 Int              @id @default(autoincrement())
  specialtyServiceId Int              @unique
  title              String           @db.VarChar(200)
  description        String           @db.Text
  headerImage        String?          @db.VarChar(500)
  color              String?          @db.VarChar(50)
  contentJson        String?          @db.LongText
  specialtyService   SpecialtyService @relation(fields: [specialtyServiceId], references: [id], onDelete: Cascade)
}

model HealthPackageSection {
  id        Int             @id @default(autoincrement())
  section   String          @db.VarChar(200)
  icon      String          @db.VarChar(100)
  sortOrder Int             @default(0)
  packages  HealthPackage[]
}

model HealthPackage {
  id            Int                  @id @default(autoincrement())
  sectionId     Int
  legacyId      Int?
  name          String               @db.VarChar(200)
  price         Int
  originalPrice Int?
  badge         String?              @db.VarChar(100)
  testsJson     String               @db.LongText
  showOnHomepage Boolean             @default(false)
  sortOrder     Int                  @default(0)
  isActive      Boolean              @default(true)
  section       HealthPackageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model BlogCategory {
  id    Int        @id @default(autoincrement())
  name  String     @unique @db.VarChar(150)
  slug  String     @unique @db.VarChar(150)
  posts BlogPost[]
}

model BlogPost {
  id              Int          @id @default(autoincrement())
  title           String       @db.VarChar(300)
  slug            String       @unique @db.VarChar(300)
  excerpt         String       @db.Text
  body            String?      @db.LongText
  image           String       @db.VarChar(500)
  categoryId      Int
  readTimeMinutes Int          @default(5)
  featured        Boolean      @default(false)
  isPublished     Boolean      @default(true)
  publishedAt     DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  category        BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  location  String   @db.VarChar(150)
  rating    Int      @default(5)
  review    String   @db.Text
  avatar    String?  @db.VarChar(500)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Faq {
  id        Int     @id @default(autoincrement())
  question  String  @db.VarChar(500)
  answer    String  @db.Text
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Statistic {
  id        Int     @id @default(autoincrement())
  value     String  @db.VarChar(50)
  label     String  @db.VarChar(200)
  context   String  @default("site") @db.VarChar(50)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  email     String   @db.VarChar(200)
  phone     String?  @db.VarChar(50)
  subject   String?  @db.VarChar(300)
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AppointmentRequest {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  phone        String   @db.VarChar(50)
  email        String?  @db.VarChar(200)
  department   String?  @db.VarChar(200)
  preferredDate DateTime?
  timeSlot     String?  @db.VarChar(50)
  packageName  String?  @db.VarChar(200)
  packagePrice String?  @db.VarChar(50)
  message      String?  @db.Text
  status       String   @default("pending") @db.VarChar(50)
  createdAt    DateTime @default(now())
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(200)
  createdAt DateTime @default(now())
}

model MediaAsset {
  id        Int      @id @default(autoincrement())
  filename  String   @db.VarChar(300)
  url       String   @db.VarChar(500)
  alt       String?  @db.VarChar(300)
  mimeType  String?  @db.VarChar(100)
  sizeBytes Int?
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  src       String   @db.VarChar(500)
  alt       String   @db.VarChar(300)
  caption   String?  @db.VarChar(300)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CenterOfExcellence {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  description String   @db.Text
  image       String   @db.VarChar(500)
  slug        String?  @db.VarChar(150)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WhyChooseUsItem {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  description String   @db.Text
  icon        String   @db.VarChar(100)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One admin-managed image slot on a public page, addressed by page + section.
/// Sections holding a single image (the care-team photo) keep one row; repeaters
/// (the hero carousel) keep one row per frame ordered by sortOrder.
model PageSectionImage {
  id        Int      @id @default(autoincrement())
  page      String   @db.VarChar(60)
  section   String   @db.VarChar(60)
  image     String   @db.VarChar(500)
  label     String?  @db.VarChar(150)
  alt       String?  @db.VarChar(300)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page, section, sortOrder])
}
